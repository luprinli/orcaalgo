# Orca Core — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.

# Alpaca Broker
ALPACA_API_KEY=PK_xxxxxxxxxxxxxxxxxxxx
ALPACA_API_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ALPACA_PAPER=true
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# Database (TimescaleDB / PostgreSQL)
ORCA_DB_HOST=localhost
ORCA_DB_PORT=5432
ORCA_DB_USER=orca
ORCA_DB_PASSWORD=change_me
ORCA_DB_NAME=orca_core
ORCA_DB_SSLMODE=disable

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Docker Compose (must match DB settings above)
DB_USER=orca
DB_PASSWORD=change_me
DB_NAME=orca_core

# Grafana (Docker Compose)
GRAFANA_USER=admin
GRAFANA_PASSWORD=change_me

# Telegram Alerts
TELEGRAM_BOT_TOKEN=xxxxxxxxxx:xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TELEGRAM_CHAT_ID=-100xxxxxxxxxx

# Trading Mode
PAPER_TRADING=true

# Odin Engine
ODIN_DLL_PATH=bin/orca_engine.dll

# Auth (REQUIRED — MUST be set, server refuses to start without these)
ORCA_JWT_SECRET=generate-a-32-char-random-string-here
ORCA_ADMIN_PASSWORD=change-me-to-a-strong-password

# LLM Providers (optional)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Python / Orca Package
ORCA_DB_URL=postgresql://orca:change_me@localhost:5432/orca_core
PYTHONUNBUFFERED=1

# Market Data
ALPACA_DATA_STREAM_URL=wss://stream.data.alpaca.markets/v2/sip