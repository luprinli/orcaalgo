{
  "__inputs": [{ "name": "DS_PROMETHEUS", "type": "datasource", "label": "Prometheus", "pluginId": "prometheus" }],
  "title": "OrcaAlgo — Regime Gauge",
  "uid": "orca-regime",
  "panels": [
    {
      "title": "Current HMM Regime",
      "type": "stat",
      "gridPos": { "x": 0, "y": 0, "w": 8, "h": 6 },
      "targets": [{ "expr": "orca_regime_state", "refId": "A" }],
      "fieldConfig": { "defaults": { "thresholds": { "steps": [
        { "value": 0, "color": "green" }, { "value": 1, "color": "blue" },
        { "value": 2, "color": "orange" }, { "value": 3, "color": "red" }
      ]}}}
    },
    {
      "title": "Regime Confidence",
      "type": "gauge",
      "gridPos": { "x": 8, "y": 0, "w": 8, "h": 6 },
      "targets": [{ "expr": "orca_hmm_confidence", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1 } }
    }
  ],
  "schemaVersion": 38,
  "version": 1
}
