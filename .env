# Orca Core — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.

# Alpaca Broker
ALPACA_API_KEY=PK_xxxxxxxxxxxxxxxxxxxx
ALPACA_API_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ALPACA_PAPER=true
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# Database (TimescaleDB / PostgreSQL) — uses port 5433 to avoid conflicts
# with any existing PostgreSQL installation on the default 5432 port.
ORCA_DB_HOST=localhost
ORCA_DB_PORT=5433
ORCA_DB_USER=orca
ORCA_DB_PASSWORD=change_me
ORCA_DB_NAME=orca_core
ORCA_DB_SSLMODE=disable

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Docker Compose reads the same ORCA_DB_* vars above (single source of truth).
# (Legacy DB_USER/DB_PASSWORD/DB_NAME removed — compose now uses ORCA_DB_*.)

# Grafana (Docker Compose)
GRAFANA_USER=admin
GRAFANA_PASSWORD=change_me

# Telegram Alerts
TELEGRAM_BOT_TOKEN=xxxxxxxxxx:xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TELEGRAM_CHAT_ID=-100xxxxxxxxxx

# Trading Mode
PAPER_TRADING=true

# Odin Engine
ODIN_DLL_PATH=bin/orca_engine.dll

# Auth (REQUIRED — MUST be set before starting server)
ORCA_JWT_SECRET=dev-jwt-secret-do-not-use-in-production-32chars
ORCA_ADMIN_PASSWORD=dev-admin-password-do-not-use-in-production

# LLM Providers (optional)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Python / Orca Package
ORCA_DB_URL=postgresql://orca:change_me@localhost:5433/orca_core
PYTHONUNBUFFERED=1

# Market Data
ALPACA_DATA_STREAM_URL=wss://stream.data.alpaca.markets/v2/sip

# Tiingo API Key (for data fetching)
TIINGO_API_KEY=142f873a1b8655fae67e0e6fd159d85876cf1735
