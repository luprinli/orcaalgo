{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qst.local/schemas/artifact_base.schema.json",
  "title": "QST Artifact Common Definitions",
  "$defs": {
    "Sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "DecimalString": {
      "type": "string",
      "pattern": "^(?!-0$)-?(0|[1-9][0-9]*)(\\.[0-9]*[1-9])?$"
    },
    "POSIXRelativePath": {
      "type": "string",
      "pattern": "^(?!/)(?!.*\\.\\.)(?!.*\\\\)[A-Za-z0-9._\\-/]+$"
    },
    "ProvenanceChain": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "parent_artifacts": {
          "type": "array",
          "items": {"$ref": "#/$defs/Sha256"},
          "default": []
        },
        "operation": {"type": ["string", "null"], "default": null},
        "notes": {
          "type": "array",
          "items": {"type": "string"},
          "default": []
        }
      }
    },
    "ArtifactRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "hash"],
      "properties": {
        "path": {"$ref": "#/$defs/POSIXRelativePath"},
        "hash": {"$ref": "#/$defs/Sha256"}
      }
    },
    "BaseArtifactProperties": {
      "artifact_id": {"anyOf": [{"$ref": "#/$defs/Sha256"}, {"type": "null"}]},
      "provenance": {"$ref": "#/$defs/ProvenanceChain"},
      "metadata": {"type": "object"},
      "raw_payload_ref": {
        "anyOf": [{"$ref": "#/$defs/POSIXRelativePath"}, {"type": "null"}]
      },
      "raw_payload_hash": {
        "anyOf": [{"$ref": "#/$defs/Sha256"}, {"type": "null"}]
      }
    }
  }
}
