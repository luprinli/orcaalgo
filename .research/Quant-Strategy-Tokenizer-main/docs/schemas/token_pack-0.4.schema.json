{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qst.local/schemas/qst_token_pack_0_4.schema.json",
  "title": "QST TokenPack 0.4",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "pack_id",
    "version",
    "namespaces",
    "tokens",
    "dependencies",
    "origin_tier",
    "attestation_kind",
    "embedded_token_policy",
    "contains_executable_code",
    "embeds_source"
  ],
  "properties": {
    "schema_version": {"const": "qst-token-pack/0.4"},
    "pack_id": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "namespaces": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "tokens": {"type": "array", "items": {"$ref": "qst_token_spec_0_4.schema.json"}},
    "dependencies": {"type": "array", "items": {"$ref": "#/$defs/dependency"}},
    "origin_tier": {
      "enum": ["core", "verified_pack", "community_pack", "user_local", "experimental", "unsafe"]
    },
    "attestation_kind": {"enum": ["none", "local_tests_passed", "qst_verified", "signed_pack"]},
    "embedded_token_policy": {"enum": ["none", "spec_only", "spec_and_source"]},
    "contains_executable_code": {"type": "boolean"},
    "embeds_source": {"type": "boolean"}
  },
  "$defs": {
    "dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pack_id", "version_constraint", "token_pack_hash"],
      "properties": {
        "pack_id": {"type": "string", "minLength": 1},
        "version_constraint": {"type": "string"},
        "token_pack_hash": {
          "oneOf": [
            {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
            {"type": "null"}
          ]
        }
      }
    }
  }
}
