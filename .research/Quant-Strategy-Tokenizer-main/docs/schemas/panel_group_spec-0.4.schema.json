{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qst.local/schemas/qst_panel_group_spec_0_4.schema.json",
  "title": "QST Panel GroupSpec 0.4",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "kind",
        "group_id",
        "mapping_ref",
        "mapping_hash",
        "missing_group_policy",
        "group_label_type"
      ],
      "properties": {
        "schema_version": { "const": "qst-panel-group-spec/0.4" },
        "kind": { "const": "static_mapping" },
        "group_id": { "type": "string", "minLength": 1 },
        "mapping_ref": {
          "type": "string",
          "pattern": "^(?!/)(?!.*\\.\\.)(?!.*\\\\).+\\.json$"
        },
        "mapping_hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "missing_group_policy": {
          "enum": ["error", "drop", "assign_unknown"],
          "default": "error"
        },
        "group_label_type": { "const": "string" }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "kind",
        "group_id",
        "field_path",
        "missing_group_policy",
        "group_label_type"
      ],
      "properties": {
        "schema_version": { "const": "qst-panel-group-spec/0.4" },
        "kind": { "const": "field_ref" },
        "group_id": { "type": "string", "minLength": 1 },
        "field_path": {
          "type": "string",
          "pattern": "^universe\\.metadata\\.[A-Za-z_][A-Za-z0-9_]*$"
        },
        "missing_group_policy": {
          "enum": ["error", "drop", "assign_unknown"],
          "default": "error"
        },
        "group_label_type": { "const": "string" }
      }
    }
  ]
}
